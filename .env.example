# ==========================================
# Root Environment Template
# See backend/.env.example and frontend/.env.example for details
# ==========================================

# Backend
PORT=8080
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/human_management
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_refresh_token_secret_min_32_characters
CORS_ORIGIN=http://localhost:3000
ENABLE_SWAGGER=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
