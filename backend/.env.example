# Server Configuration
PORT=8080
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/human_management

# Authentication Secrets (generate secure random strings in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_refresh_token_secret_min_32_characters

# CORS Configuration (comma-separated or single domain)
CORS_ORIGIN=http://localhost:3000

# Swagger Documentation (set to false in production for security)
ENABLE_SWAGGER=false
